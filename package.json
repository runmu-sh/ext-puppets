{
  "name": "@runmu.sh/ext-puppets",
  "version": "1.2.0",
  "description": "Remote puppet viewpoints: a feed, scene and command line per puppet, with unread counts on the tab, driven by GMCP Client.Puppets.* or another extension's API.",
  "keywords": [
    "puppets",
    "npc",
    "staff",
    "gmcp",
    "panel"
  ],
  "license": "MIT",
  "homepage": "https://runmu.sh/marketplace/x/puppets",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/runmu-sh/ext-puppets.git"
  },
  "bugs": {
    "url": "https://github.com/runmu-sh/ext-puppets/issues"
  },
  "type": "module",
  "exports": "./dist/index.js",
  "types": "./src/types.ts",
  "files": [
    "dist",
    "src/types.ts",
    "schema",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.mjs",
    "check": "node scripts/build.mjs --check"
  },
  "devDependencies": {
    "@muclient/sdk": "npm:@runmu.sh/sdk@^1.12.0",
    "@runmu.sh/dev": "^0.2.0",
    "esbuild": "^0.28.2",
    "happy-dom": "^20.0.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=20"
  },
  "muclient": {
    "id": "puppets",
    "api": "^1.12",
    "source": "src/index.ts",
    "displayName": "Puppets",
    "description": "Remote puppet viewpoints: a feed, scene and command line per puppet, with unread counts on the tab, driven by GMCP Client.Puppets.* or another extension's API.",
    "categories": [
      "interface",
      "games"
    ],
    "contributes": {
      "panels": [
        {
          "id": "puppets",
          "title": "Puppets",
          "singleton": true,
          "defaultPosition": "right-top"
        }
      ],
      "gmcp": [
        {
          "package": "Client.Puppets 1",
          "messages": {
            "Client.Puppets.Manifest": {
              "dir": "in",
              "schema": "schema/manifest.json"
            },
            "Client.Puppets.Feed": {
              "dir": "in",
              "schema": "schema/feed.json"
            },
            "Client.Puppets.Scene": {
              "dir": "in",
              "schema": "schema/scene.json"
            },
            "Client.Puppets.Sync": {
              "dir": "in",
              "schema": "schema/sync.json"
            },
            "Client.Puppets.Resync": {
              "dir": "out",
              "schema": "schema/resync.json"
            },
            "Client.Puppets.Command": {
              "dir": "out",
              "schema": "schema/command.json"
            },
            "Client.Puppets.Add": {
              "dir": "out",
              "schema": "schema/add.json"
            }
          }
        }
      ]
    },
    "capabilities": [
      "send-commands",
      "files"
    ],
    "publisher": "bitmuse"
  }
}
